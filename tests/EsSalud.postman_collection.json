{
  "info": {
    "name": "Mi Salud - API local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "email",
      "value": "paciente@demo.pe"
    },
    {
      "key": "password",
      "value": "CONFIGURAR_CONTRASENA_DEMO"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "doctorId",
      "value": "1"
    },
    {
      "key": "slotId",
      "value": "1"
    },
    {
      "key": "appointmentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Iniciar sesión (guarda token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Mi perfil",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/me"
      }
    },
    {
      "name": "03 Especialidades",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/specialties"
      }
    },
    {
      "name": "04 Médicos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/doctors"
      }
    },
    {
      "name": "05 Turnos disponibles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/slots?doctorId={{doctorId}}"
      }
    },
    {
      "name": "06 Reservar turno (elegir slotId libre)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"appointmentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Mis citas / agenda médica",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/appointments"
      }
    },
    {
      "name": "08 Cancelar mi cita",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/appointments/{{appointmentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CANCELADA\"\n}"
        }
      }
    },
    {
      "name": "09 Marcar atendida (médico asignado)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/appointments/{{appointmentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ATENDIDA\"\n}"
        }
      }
    },
    {
      "name": "10 Resumen (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/summary"
      }
    },
    {
      "name": "11 Agenda paginada (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/appointments?page=0&date=&status=&doctorId=0"
      }
    },
    {
      "name": "12 Auditoría (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/audit"
      }
    },
    {
      "name": "13 Nueva especialidad (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/specialties",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Especialidad de prueba\",\n  \"active\": true,\n  \"direct\": true\n}"
        }
      }
    }
  ]
}
